{
  "version": 2,
  "name": "The Training Block (lab)",
  "scope": "[data-world=\"training\"]",
  "status": "lab exploration; not the SkillUp DS (the SkillUp DS in Figma stays the authority; integration is a later step)",
  "source": "tokens/lab-training.css",
  "routes": [
    "/lab/training",
    "/lab/training/plans",
    "/lab/training/course/six-sigma"
  ],
  "distilled": {
    "date": "2026-09-29",
    "why": "first version was cognitively overwhelming",
    "principle": [
      "one job per page",
      "at most one primary action per page",
      "three marks: done, today/next, planned",
      "one accent: accent yellow = today, the only accent yellow on a page",
      "moved and live are said in words"
    ],
    "voices": {
      "display": "page titles and today's session title only",
      "text": "everything else, sentence case"
    },
    "mockTag": "one per page, at the bottom",
    "pageJobs": {
      "today": "start today's session",
      "plans": "pick a plan",
      "coursePlan": "continue, and see what is left"
    },
    "removed": [
      "session blocks sized by minutes",
      "topic widths",
      "hatching and dashed moved outlines",
      "green live colour",
      "12-week strips",
      "load meter and legends",
      "road to race day",
      "race-day and around-this-plan blocks",
      "tb-replan-in motion",
      "tb-num-* sizes",
      "condensed caps labels and buttons",
      "--tb-live, --tb-live-wash, --tb-accent yellow-deep"
    ]
  },
  "colors": {
    "ground": {
      "value": "#f2f4f3",
      "var": "--tb-ground",
      "role": "page ground"
    },
    "sheet": {
      "value": "#ffffff",
      "var": "--tb-sheet",
      "role": "nav bar, Change days panel"
    },
    "ink": {
      "value": "#0e2b34",
      "var": "--tb-ink",
      "role": "text, done day mark, pressed day toggle, avatar, desktop nav current bar"
    },
    "ink-2": {
      "value": "#3c5660",
      "var": "--tb-ink-2",
      "role": "secondary text, done check on course plan",
      "contrastOnSheet": 7.3
    },
    "ink-3": {
      "value": "#5b727a",
      "var": "--tb-ink-3",
      "role": "tertiary text, lock, rest-day dot, not-built nav items",
      "contrastOnSheet": 4.9
    },
    "rule": {
      "value": "#d5dcdc",
      "var": "--tb-rule",
      "role": "1px hairlines between rows and above sections"
    },
    "teal": {
      "value": "#26708e",
      "var": "--tb-teal",
      "role": "the plan: planned marks, primary button, links, focus ring (SkillUp teal, fixed)"
    },
    "teal-deep": {
      "value": "#1b5268",
      "var": "--tb-teal-deep",
      "role": "hover"
    },
    "teal-wash": {
      "value": "#e3eef2",
      "var": "--tb-teal-wash",
      "role": "phone tab bar current pill only"
    },
    "now": {
      "value": "#f9c654",
      "var": "--tb-now",
      "source": "SKO DS --color-bg-accent-yellow",
      "on": "--color-text-on-accent-yellow #13282f",
      "role": "today: today's day mark, the course plan's next-topic mark; one per page, always with a 1.5px ink inset"
    }
  },
  "fonts": {
    "family": {
      "family": "Montserrat",
      "source": "SKO DS --sk-font-display / --sk-font-body (next/font in app/layout.tsx)",
      "weights": [
        400,
        600
      ],
      "use": "everything; titles at 600 with -0.02em tracking"
    }
  },
  "typography": {
    "tb-display": {
      "font": "family",
      "weight": 800,
      "size": "clamp(2.5rem, 1.6rem + 3.2vw, 4.75rem)",
      "lineHeight": 0.95,
      "letterSpacing": "-0.01em",
      "use": "today's session title"
    },
    "tb-h1": {
      "font": "family",
      "weight": 800,
      "size": "clamp(2rem, 1.5rem + 1.8vw, 3rem)",
      "lineHeight": 1,
      "use": "page titles (Plans, course plan)"
    },
    "tb-h2": {
      "font": "family",
      "weight": 600,
      "size": "1.25rem",
      "lineHeight": 1.3,
      "use": "section headings"
    },
    "tb-title": {
      "font": "family",
      "weight": 600,
      "size": "1.25rem",
      "lineHeight": 1.25,
      "use": "plan, module and next-topic titles"
    },
    "tb-body": {
      "font": "family",
      "weight": 400,
      "size": "1rem",
      "lineHeight": 1.5
    },
    "tb-body-s": {
      "font": "family",
      "weight": 400,
      "size": "0.875rem",
      "lineHeight": 1.45
    },
    "tb-label": {
      "font": "family",
      "weight": 600,
      "size": "0.8125rem",
      "lineHeight": 1.3,
      "use": "nav items, day toggles, lesson names, avatar initials"
    },
    "tb-meta": {
      "font": "family",
      "weight": 400,
      "size": "0.8125rem",
      "lineHeight": 1.4,
      "numeric": "tabular-nums"
    },
    "case": "sentence case everywhere; no uppercase transforms",
    "scaleVar": "--sk-font-scale",
    "minTextPx": 13
  },
  "radius": {
    "sheet": "3px",
    "button": "3px",
    "dayToggle": "2px",
    "topicMark": "1px",
    "circles": "day marks (40px), avatar, phone-tab pill"
  },
  "layout": {
    "contentMax": "880px, single column",
    "barMax": "1280px",
    "gutter": {
      "base": "16px",
      "md": "32px"
    },
    "sections": "1px rule on top, 40–48px apart"
  },
  "targets": {
    "minMobile": "44px",
    "nav": "64px",
    "primaryButton": "52px",
    "moduleButton": "56px"
  },
  "focus": {
    "outline": "3px solid teal",
    "offset": "2px"
  },
  "motion": {
    "button": {
      "duration": "160ms",
      "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)",
      "reducedMotion": "none"
    },
    "accordionChevron": {
      "property": "rotate 180deg",
      "reducedMotion": "none"
    }
  },
  "marks": {
    "today": {
      "done": "40px ink circle with white check",
      "today": "40px accent yellow circle",
      "planned": "40px circle, 1.5px teal outline",
      "rest": "4px ink-3 dot"
    },
    "coursePlan": {
      "done": "16px ink-2 check",
      "next": "12px accent yellow square, 1.5px ink inset",
      "planned": "12px square, 1.5px teal outline",
      "locked": "14px ink-3 lock, reason in meta line"
    }
  },
  "rules": {
    "oneAccent": "accent yellow on one thing per page: the mark that is today (course plan: today's next topic); never nav, buttons, headings, row fills or status",
    "saidInWords": "moved and live are words in the meta line, never a colour, outline or pattern",
    "onePrimary": "at most one primary button per page; every other action is quiet",
    "navCurrent": "ink 4px bar (desktop) / teal-wash pill (phone), never accent yellow",
    "kickers": "none above headings, except the date line above today's session title",
    "icons": "Lucide via Icon; no Unicode glyph icons",
    "unwiredActions": "DemoAction announces 'Lab demo — this action isn't wired yet.'",
    "mockValues": "one MockTag per page, at the bottom, with its reason",
    "signatureInteraction": "Change days: aria-expanded disclosure, seven aria-pressed day toggles, quiet 'Use these days', role=status result; no 'Keep this plan' button because keeping is the default"
  },
  "open": []
}
