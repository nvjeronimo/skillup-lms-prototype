    "tokens:build": "node scripts/tokens/build.mjs",
    "tokens:check": "node scripts/tokens/build.mjs --check",
    "tokens:compare": "node scripts/tokens/compare.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "clsx": "2.1.1",
    "lucide-react": "0.460.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/node": "20.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/parser": "8.59.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-storybook": "10.6.0",
    "postcss": "8.4.49",
    "prettier": "3.3.3",
    "prettier-plugin-tailwindcss": "0.6.9",
    "storybook": "10.6.0",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "8.2.2",
    "vitest": "5.0.4"
